<Window x:Class="FastFoodSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        Title="Fast Food Simulator"
        Width="1480"
        Height="940"
        MinWidth="1180"
        MinHeight="780"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        mc:Ignorable="d">

    <Window.Resources>

        <DataTemplate x:Key="OrderLineCustomerTemplate">
            <Border Width="38"
                    Height="38"
                    Margin="0,0,8,8"
                    Background="#16263F"
                    BorderBrush="#294268"
                    BorderThickness="1"
                    CornerRadius="19"
                    ToolTip="{Binding Tooltip}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="12"
                           FontWeight="Bold"
                           Foreground="#8FC2FF"
                           Text="{Binding Number}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ServingLineCustomerTemplate">
            <Border Width="34"
                    Height="34"
                    Margin="0,0,7,7"
                    Background="#2A2112"
                    BorderBrush="#5A4318"
                    BorderThickness="1"
                    CornerRadius="17"
                    ToolTip="{Binding Tooltip}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="11"
                           FontWeight="Bold"
                           Foreground="#F5C76B"
                           Text="{Binding Number}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="DiningCustomerTemplate">
            <Border Width="30"
                    Height="30"
                    Margin="0,0,7,7"
                    Background="#102820"
                    BorderBrush="#1D4D3D"
                    BorderThickness="1"
                    CornerRadius="15"
                    ToolTip="{Binding Tooltip}">
                <TextBlock HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontFamily="Consolas"
                           FontSize="10"
                           FontWeight="Bold"
                           Foreground="#7DE2B8"
                           Text="{Binding Number}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="KitchenOrderTemplate">
            <Border Margin="0,0,7,7"
                    Padding="9,5"
                    Background="#211A31"
                    BorderBrush="#463463"
                    BorderThickness="1"
                    CornerRadius="8"
                    ToolTip="{Binding Tooltip}">
                <TextBlock FontFamily="Consolas"
                           FontSize="12.5"
                           FontWeight="Bold"
                           Foreground="#D0B7FF"
                           Text="{Binding Label}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="AnnouncementTemplate">
            <Border Margin="0,0,6,6"
                    Padding="8,4"
                    Background="#102720"
                    BorderBrush="#1D4A3D"
                    BorderThickness="1"
                    CornerRadius="8"
                    ToolTip="{Binding Tooltip}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Consolas"
                               FontSize="12"
                               FontWeight="Bold"
                               Foreground="#6EE7B7"
                               Text="{Binding OrderLabel}" />
                    <TextBlock Margin="6,0,0,0"
                               VerticalAlignment="Center"
                               FontSize="9.5"
                               Foreground="#5F7F78"
                               Text="{Binding CustomerLabel}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="ActorTemplate">
            <Border Width="154">
                <Border.Style>
                    <Style BasedOn="{StaticResource ActorCard}" TargetType="{x:Type Border}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="BorderBrush" Value="{Binding AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border Width="30"
                                Height="30"
                                Background="{Binding AccentSoftBrush}"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="10.5"
                                       FontWeight="Bold"
                                       Foreground="{Binding AccentBrush}"
                                       Text="{Binding BadgeText}" />
                        </Border>

                        <StackPanel Grid.Column="1"
                                    Margin="8,0,6,0"
                                    VerticalAlignment="Center">
                            <TextBlock FontSize="11.5"
                                       FontWeight="SemiBold"
                                       Text="{Binding Title}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock FontSize="9.5"
                                       Foreground="{Binding StatusBrush}"
                                       Text="{Binding StatusText}"
                                       TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <Ellipse Grid.Column="2"
                                 Width="6"
                                 Height="6"
                                 Margin="0,4,2,0"
                                 VerticalAlignment="Top"
                                 Fill="{Binding ActivityBrush}" />
                    </Grid>

                    <Grid Margin="0,9,0,0">
                        <TextBlock FontFamily="Consolas"
                                   FontSize="19"
                                   FontWeight="Bold"
                                   Foreground="{Binding OrderBrush}"
                                   Text="{Binding OrderDisplay}" />
                        <TextBlock Margin="0,0,2,3"
                                   HorizontalAlignment="Right"
                                   VerticalAlignment="Bottom"
                                   FontSize="9"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="заказ" />
                    </Grid>

                    <ProgressBar Height="4"
                                 Margin="0,5,0,0"
                                 Background="#0A0F19"
                                 Foreground="{Binding AccentBrush}"
                                 Maximum="100"
                                 Value="{Binding Progress, Mode=OneWay}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <Style x:Key="EmptyStateText" TargetType="{x:Type TextBlock}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="10" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="CardSubtitle" TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,5,0,0" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{StaticResource TextMutedBrush}" />
        </Style>

    </Window.Resources>

    <Grid Margin="26,20,26,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Grid Grid.Row="0" Margin="2,0,2,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="46"
                        Height="46"
                        Background="{StaticResource AccentBrush}"
                        CornerRadius="13">
                    <TextBlock HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="15"
                               FontWeight="Black"
                               Foreground="#171006"
                               Text="FF" />
                </Border>

                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock FontSize="22"
                               FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               Text="FAST FOOD SIMULATOR" />
                    <TextBlock Margin="0,1,0,0"
                               FontSize="11"
                               Foreground="{StaticResource TextMutedBrush}"
                               Text="Конвейер заказов · WPF + .NET 9" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <Border Margin="0,0,10,0"
                        Padding="12,7"
                        Background="#111826"
                        BorderBrush="#202A3D"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel Orientation="Horizontal">
                        <Ellipse Width="8"
                                 Height="8"
                                 Margin="0,0,7,0"
                                 VerticalAlignment="Center"
                                 Fill="{Binding StatusBrush}"
                                 Style="{StaticResource PulseDot}" />
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{Binding StatusBrush}"
                                   Text="{Binding StatusBadgeText}" />
                    </StackPanel>
                </Border>

                <Border Padding="14,7"
                        Background="#111826"
                        BorderBrush="#202A3D"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="9.5"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="ВРЕМЯ" />
                        <TextBlock Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   FontFamily="Consolas"
                                   FontSize="17"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ElapsedText}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>

        <!-- Панель управления -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="18,14"
                Style="{StaticResource MainCard}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ИНТЕРВАЛ ПРИХОДА" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="86"
                                     MaxLength="6"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     Text="{Binding ArrivalIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="сек" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ПРИГОТОВЛЕНИЕ" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="86"
                                     MaxLength="6"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     Text="{Binding PreparationIntervalText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="сек" />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,24,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ОРДЕР-ТЕЙКЕРЫ" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="62"
                                     MaxLength="3"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     Text="{Binding OrderTakerCountText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="чел." />
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="3">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ПОВАРА" />
                        <StackPanel Orientation="Horizontal">
                            <TextBox Width="62"
                                     MaxLength="3"
                                     IsEnabled="{Binding IsInputEnabled}"
                                     Text="{Binding CookCountText, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Margin="7,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="чел." />
                        </StackPanel>
                    </StackPanel>

                    <Border Grid.Column="5"
                            Width="1"
                            Height="40"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Background="#252F43" />

                    <StackPanel Grid.Column="6"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                        <Button Width="128"
                                Command="{Binding StartCommand}"
                                Content="▶  Старт"
                                Style="{StaticResource PrimaryButton}" />
                        <Button Width="112"
                                Margin="10,0,0,0"
                                Command="{Binding StopCommand}"
                                Content="■  Стоп"
                                Style="{StaticResource DangerButton}" />
                    </StackPanel>
                </Grid>

                <Border Margin="0,12,0,0"
                        Padding="12,9"
                        Background="#2A141C"
                        BorderBrush="#6B2B3B"
                        BorderThickness="1"
                        CornerRadius="10"
                        Visibility="{Binding HasValidationError, Converter={StaticResource BoolToVisibility}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Background="{StaticResource DangerBrush}"
                                CornerRadius="9">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       FontWeight="Black"
                                       Foreground="#1A0A0F"
                                       Text="!" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   VerticalAlignment="Center"
                                   FontSize="11.5"
                                   Foreground="#F9A8B4"
                                   Text="{Binding ValidationMessage}"
                                   TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Статистика -->
        <UniformGrid Grid.Row="2"
                     Margin="0,0,0,12"
                     Columns="4">
            <Border Margin="0,0,10,0" Style="{StaticResource StatsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Background="{StaticResource InfoBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="КЛИЕНТОВ ПРИШЛО" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding ArrivedCustomers}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,0,10,0" Style="{StaticResource StatsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Background="{StaticResource AccentBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ЗАКАЗОВ СОЗДАНО" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding CreatedOrders}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Margin="0,0,10,0" Style="{StaticResource StatsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Background="{StaticResource KitchenBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ЗАКАЗОВ НА КУХНЕ" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding KitchenTotalCount}" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource StatsCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Width="3" Background="{StaticResource SuccessBrush}" CornerRadius="2" />
                    <StackPanel Grid.Column="1" Margin="12,0,0,0">
                        <TextBlock Style="{StaticResource FieldLabel}" Text="ЗАКАЗОВ ВЫДАНО" />
                        <TextBlock FontFamily="Consolas"
                                   FontSize="23"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="{Binding CompletedOrders}" />
                    </StackPanel>
                </Grid>
            </Border>
        </UniformGrid>

        <!-- Основная визуализация -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.9*" />
                <ColumnDefinition Width="1.15*" />
                <ColumnDefinition Width="1.55*" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <!-- Очередь клиентов и зал -->
            <Grid Grid.Column="0" Margin="0,0,12,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="1.6*" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Style="{StaticResource MainCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InfoBrush}"
                                           Text="01" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="9,0,0,0"
                                       Style="{StaticResource SectionTitle}"
                                       Text="ОЧЕРЕДЬ КЛИЕНТОВ" />
                            <Border Grid.Column="2" Style="{StaticResource CountPill}">
                                <TextBlock FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource InfoBrush}"
                                           Text="{Binding OrderLineCount}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource CardSubtitle}"
                                   Text="{Binding OrderLineStatusText}" />

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                              ItemTemplate="{StaticResource OrderLineCustomerTemplate}"
                                              ItemsSource="{Binding OrderLine}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource EmptyStateText}"
                                       Text="Клиенты появятся после запуска симуляции"
                                       Visibility="{Binding HasOrderLineCustomers, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                    </Grid>
                </Border>

                <Border Grid.Row="2" Padding="15" Style="{StaticResource MainCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MintBrush}"
                                           Text="05" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="9,0,0,0"
                                       Style="{StaticResource SectionTitle}"
                                       Text="ЗОНА ОТДЫХА" />
                            <Border Grid.Column="2" Style="{StaticResource CountPill}">
                                <TextBlock FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource MintBrush}"
                                           Text="{Binding DiningRoom.Count}" />
                            </Border>
                        </Grid>

                        <TextBlock Grid.Row="1"
                                   Style="{StaticResource CardSubtitle}"
                                   Text="{Binding DiningCountLabel}" />

                        <Grid Grid.Row="2" Margin="0,10,0,0">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                              ItemTemplate="{StaticResource DiningCustomerTemplate}"
                                              ItemsSource="{Binding DiningRoom}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource EmptyStateText}"
                                       Text="Здесь будут клиенты, получившие заказ"
                                       Visibility="{Binding HasDiningRoomCustomers, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>

            <!-- Ордер-тейкеры -->
            <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    Style="{StaticResource MainCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource AccentBrush}"
                                       Text="02" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   Style="{StaticResource SectionTitle}"
                                   Text="ОРДЕР-ТЕЙКЕРЫ" />
                        <Border Grid.Column="2" Style="{StaticResource CountPill}">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding TakerCountLabel}" />
                        </Border>
                    </Grid>

                    <TextBlock Grid.Row="1"
                               Style="{StaticResource CardSubtitle}"
                               Text="{Binding TakerBusyLabel}" />

                    <Grid Grid.Row="2" Margin="0,11,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                          ItemTemplate="{StaticResource ActorTemplate}"
                                          ItemsSource="{Binding OrderTakers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource EmptyStateText}"
                                   Text="Команда выйдет на смену сразу после старта"
                                   Visibility="{Binding HasOrderTakers, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Кухня -->
            <Border Grid.Column="2"
                    Margin="0,0,12,0"
                    Style="{StaticResource MainCard}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource StepBadge}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontFamily="Consolas"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource KitchenBrush}"
                                       Text="03" />
                        </Border>
                        <TextBlock Grid.Column="1"
                                   Margin="9,0,0,0"
                                   Style="{StaticResource SectionTitle}"
                                   Text="КУХНЯ" />
                        <Border Grid.Column="2" Style="{StaticResource CountPill}">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding KitchenWaitingLabel}" />
                        </Border>
                    </Grid>

                    <Border Grid.Row="1"
                            Margin="0,11,0,0"
                            Padding="11,9"
                            Style="{StaticResource InnerCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <TextBlock Style="{StaticResource SmallCaption}"
                                           FontWeight="SemiBold"
                                           Text="КАРУСЕЛЬ ЗАКАЗОВ" />
                                <TextBlock HorizontalAlignment="Right"
                                           Style="{StaticResource SmallCaption}"
                                           Text="FIFO" />
                            </Grid>

                            <Grid Grid.Row="1" MinHeight="34" Margin="0,7,0,0">
                                <ScrollViewer HorizontalScrollBarVisibility="Auto"
                                              VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                                  ItemTemplate="{StaticResource KitchenOrderTemplate}"
                                                  ItemsSource="{Binding KitchenQueue}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource EmptyStateText}"
                                           Text="Карусель пуста — заказов пока нет"
                                           Visibility="{Binding HasKitchenOrders, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,14,0,0">
                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="ПОВАРА" />
                            <TextBlock Margin="9,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SmallCaption}"
                                       Text="{Binding CookBusyLabel}" />
                        </StackPanel>
                        <Border HorizontalAlignment="Right" Style="{StaticResource CountPill}">
                            <TextBlock FontSize="10"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       Text="{Binding CookCountLabel}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,9,0,0">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                          ItemTemplate="{StaticResource ActorTemplate}"
                                          ItemsSource="{Binding Cooks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                        <TextBlock Style="{StaticResource EmptyStateText}"
                                   Text="Повара приступят к работе сразу после старта"
                                   Visibility="{Binding HasCooks, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                    </Grid>
                </Grid>
            </Border>

            <!-- Выдача -->
            <Border Grid.Column="3" Style="{StaticResource MainCard}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StepBadge}">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontFamily="Consolas"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="04" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="9,0,0,0"
                                       Style="{StaticResource SectionTitle}"
                                       Text="ВЫДАЧА" />
                            <Border Grid.Column="2" Style="{StaticResource CountPill}">
                                <TextBlock FontFamily="Consolas"
                                           FontSize="12"
                                           FontWeight="Bold"
                                           Foreground="{StaticResource SuccessBrush}"
                                           Text="{Binding ServingLineCount}" />
                            </Border>
                        </Grid>

                        <TextBlock Style="{StaticResource CardSubtitle}"
                                   Text="{Binding ServingLineStatusText}" />

                        <Border Margin="0,12,0,0"
                                Padding="14,12"
                                Background="#0E241D"
                                BorderBrush="#1F4B3D"
                                BorderThickness="1"
                                CornerRadius="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="1,0,0,3"
                                               Style="{StaticResource FieldLabel}"
                                               Text="СЕЙЧАС ГОТОВ" />
                                    <TextBlock FontFamily="Consolas"
                                               FontSize="34"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="{Binding LastOrderDisplay}" />
                                    <TextBlock Margin="0,1,0,0"
                                               Style="{StaticResource SmallCaption}"
                                               Text="{Binding LastOrderCaption}" />
                                </StackPanel>
                                <Border Grid.Column="1"
                                        Width="38"
                                        Height="38"
                                        VerticalAlignment="Center"
                                        Background="#153B2D"
                                        CornerRadius="19">
                                    <TextBlock HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="17"
                                               Foreground="{StaticResource SuccessBrush}"
                                               Text="✓" />
                                </Border>
                            </Grid>
                        </Border>

                        <Grid Margin="0,13,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="СЕРВЕР" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SmallCaption}"
                                       Text="вызывает номера" />
                        </Grid>

                        <Grid Margin="0,7,0,0" MinHeight="84">
                            <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                          ItemTemplate="{StaticResource ActorTemplate}"
                                          ItemsSource="{Binding Servers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EmptyStateText}"
                                       Text="Сервер появится после запуска"
                                       Visibility="{Binding HasServers, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="ЛИНИЯ ВЫДАЧИ" />
                            <TextBlock HorizontalAlignment="Right"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource SmallCaption}"
                                       Text="ждут вызова" />
                        </Grid>

                        <Grid Margin="0,7,0,0" MinHeight="38">
                            <ScrollViewer MaxHeight="74"
                                          HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                              ItemTemplate="{StaticResource ServingLineCustomerTemplate}"
                                              ItemsSource="{Binding ServingLine}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock Style="{StaticResource EmptyStateText}"
                                       Text="На линии пока никого"
                                       Visibility="{Binding HasServingLineCustomers, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </Grid>

                        <Grid Margin="0,10,0,0">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="НЕДАВНО ВЫДАНО" />
                        </Grid>

                        <Grid Margin="0,7,0,0" MinHeight="30">
                            <ItemsControl ItemContainerStyle="{StaticResource FadeInPresenter}"
                                          ItemTemplate="{StaticResource AnnouncementTemplate}"
                                          ItemsSource="{Binding RecentAnnouncements}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <TextBlock Style="{StaticResource EmptyStateText}"
                                       Text="Заказы появятся после выдачи"
                                       Visibility="{Binding HasRecentAnnouncements, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
